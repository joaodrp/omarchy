#!/bin/bash
#
# DNS goes to this machine's dedicated ControlD endpoint over DoT, spoken by
# systemd-resolved directly -- no forwarding daemon. Resolver ID comes from the
# `controld_resolver_id` chezmoi field (per-machine, local, never committed).
#
# Everything that is not templated -- the NetworkManager files, restoring after
# the DNS panel switches away, verifying -- belongs to `dns-controld`, which is
# also what the menu calls. This writes the one file that needs the id, then
# hands over, so there is a single owner of the runtime state.
#
# MagicDNS is left entirely to tailscaled: with the tailnet's "Override DNS
# servers" off, it claims only `ts.net` on its own link and ControlD stays the
# default. Anything that reasserts that link config from here loses a race with
# tailscaled, so don't.
#
# Captive portals: `dns-controld --pause`, sign in, then `dns-controld`.
#
# Reverse: sudo rm -f /etc/systemd/resolved.conf.d/50-controld.conf
#          sudo rm -f /etc/NetworkManager/conf.d/{99-dns-none,20-omarchy-dns}.conf
#          sudo systemctl restart systemd-resolved NetworkManager
set -euo pipefail

RESOLVER_ID="{{ if hasKey . "controld_resolver_id" }}{{ .controld_resolver_id }}{{ end }}"
[[ -z "$RESOLVER_ID" ]] && exit 0

DOT_HOST="$RESOLVER_ID.dns.controld.com"
DROPIN=/etc/systemd/resolved.conf.d/50-controld.conf
PAUSED=$DROPIN.disabled

# `#hostname` is SNI plus certificate validation, and carries the resolver id
# that selects this machine's ControlD profile. Empty FallbackDNS so an
# unreachable endpoint fails closed instead of leaking to Google/Cloudflare.
#
# No `Domains=` here: resolved treats a domain without `~` as routing as well
# as search, so a global tailnet suffix would make the global scope
# authoritative for tailnet names and send them to ControlD. tailscaled sets
# it per link.
DROPIN_CONTENT="[Resolve]
DNS=76.76.2.22#$DOT_HOST 76.76.10.22#$DOT_HOST
DNSOverTLS=yes
FallbackDNS="

# Write to whichever name is live so an apply cannot silently un-pause.
target=$DROPIN
[[ -f $PAUSED ]] && target=$PAUSED

if [[ "$(sudo cat "$target" 2>/dev/null)" != "$DROPIN_CONTENT" ]]; then
    printf '%s\n' "$DROPIN_CONTENT" | sudo install -Dm644 /dev/stdin "$target"
fi

# Lets tailscaled own MagicDNS. Safe only while the tailnet's Override is off;
# with it on this machine would silently move to the shared tailnet profile.
sudo tailscale set --accept-dns=true

if [[ -f $PAUSED ]]; then
    echo "ControlD is paused; endpoint updated but not applied. Restore with: dns-controld"
elif command -v dns-controld >/dev/null 2>&1; then
    dns-controld
else
    echo "dns-controld not on PATH yet; re-run chezmoi apply to finish." >&2
fi
