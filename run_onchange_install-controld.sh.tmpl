#!/bin/bash
#
# Pin this machine to its dedicated ControlD endpoint via ctrld's `--cd` setup.
# Resolver ID comes from the `controld_resolver_id` chezmoi onboarding field
# (per-machine, local, never committed); blank skips ctrld.
#
# CAVEAT (revisit if needed): `accept-dns=false` drops Tailscale DNS, so MagicDNS
# (`*.ts.net`) won't resolve here. To restore, swap `--cd` for a static
# ctrld.toml forwarding `*.ts.net` to 100.100.100.100 (see git history / the
# `controld-setup` memory). Inbound SSH is unaffected.
#
# Reverse: sudo ctrld uninstall; sudo tailscale set --accept-dns=true;
#          sudo rm -f /etc/NetworkManager/dispatcher.d/05-ctrld-dns; omarchy dns DHCP
# Change resolver: `sudo ctrld uninstall` first, then re-apply.
set -euo pipefail

RESOLVER_ID="{{ if hasKey . "controld_resolver_id" }}{{ .controld_resolver_id }}{{ end }}"
[[ -z "$RESOLVER_ID" ]] && exit 0

omarchy-pkg-aur-add ctrld-bin

# First run only. --skip_self_checks: ctrld's probe is flaky next to resolved.
[[ -f /etc/systemd/system/ctrld.service ]] || sudo ctrld start --cd "$RESOLVER_ID" --skip_self_checks

# Hand DNS to ctrld; keep tailscaled up for SSH.
sudo tailscale set --accept-dns=false

# Pin every uplink to ctrld so DHCP never reintroduces the router's servers.
# ctrld only pins the link holding the default route when it starts, so any
# other link that comes up later carries DHCP DNS -- and systemd-resolved will
# happily use it, because resolution is routed per link.
#
# It has to be per connection profile. Neither NetworkManager's global-dns nor
# a [connection-*] default reaches resolved once ctrld's own drop-in sets
# `dns=none`; both were measured doing nothing here.
pin_dns() {
    sudo nmcli connection modify "$1" \
        ipv4.ignore-auto-dns yes ipv4.dns 127.0.0.1 \
        ipv6.ignore-auto-dns yes
}

while IFS=: read -r uuid type; do
    case "$type" in
    802-11-wireless | 802-3-ethernet | gsm | cdma) ;;
    *) continue ;;
    esac
    [ "$(nmcli -g ipv4.ignore-auto-dns connection show "$uuid")" = "yes" ] || pin_dns "$uuid"
done < <(nmcli -t -f UUID,TYPE connection show)

while IFS=: read -r dev state type; do
    [ "$state" = "connected" ] || continue
    case "$type" in wifi | ethernet | gsm) sudo nmcli device reapply "$dev" >/dev/null 2>&1 || true ;; esac
done < <(nmcli -t -f DEVICE,STATE,TYPE device status)

# Profiles added later (a new SSID) would still arrive unpinned, so catch them
# as they come up. Same guard-then-reapply shape as the metric dispatcher.
dispatcher=/etc/NetworkManager/dispatcher.d/05-ctrld-dns
dispatcher_content=$(cat <<'DISPATCHER'
#!/bin/bash
iface=$1
action=$2

[ "$action" = "up" ] || exit 0
[ -n "${CONNECTION_UUID:-}" ] || exit 0

case "$(nmcli -g connection.type connection show "$CONNECTION_UUID" 2>/dev/null)" in
    802-11-wireless|802-3-ethernet|gsm|cdma) ;;
    *) exit 0 ;;
esac

[ "$(nmcli -g ipv4.ignore-auto-dns connection show "$CONNECTION_UUID")" = "yes" ] && exit 0

nmcli connection modify "$CONNECTION_UUID" \
    ipv4.ignore-auto-dns yes ipv4.dns 127.0.0.1 ipv6.ignore-auto-dns yes
nmcli device reapply "$iface"
DISPATCHER
)

if [ "$(sudo cat "$dispatcher" 2>/dev/null)" != "$dispatcher_content" ]; then
    printf '%s\n' "$dispatcher_content" | sudo tee "$dispatcher" >/dev/null
    sudo chown root:root "$dispatcher"
    sudo chmod 0755 "$dispatcher"
fi

# Cosmetic but load-bearing for the UI: `omarchy dns` and the shell's network
# panel read this file to decide which provider is highlighted. Without it they
# report DHCP, which invites a click that would repoint DNS away from ctrld.
sudo install -d -m 0755 /etc/NetworkManager/conf.d
sudo tee /etc/NetworkManager/conf.d/20-omarchy-dns.conf >/dev/null <<'EOF'
# Managed by omarchy-dns. Remove this file or run omarchy dns DHCP to use DHCP DNS again.
[global-dns]

[global-dns-domain-*]
servers=127.0.0.1
EOF
sudo nmcli general reload conf >/dev/null 2>&1 || true
