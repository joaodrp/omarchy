#!/bin/bash
#
# Pin this machine to its dedicated ControlD endpoint, and keep MagicDNS working
# alongside it. Resolver ID comes from the `controld_resolver_id` chezmoi
# onboarding field (per-machine, local, never committed); blank skips ctrld.
#
# Local config mode, not `--cd`: the MagicDNS rule has to live in a file the API
# will not regenerate, so the captive-portal list is refetched on every apply. A
# machine joining the tailnet later gets its search domain on the next apply.
#
# Reverse: sudo ctrld uninstall; sudo tailscale set --accept-dns=true;
#          sudo rm -f /etc/NetworkManager/dispatcher.d/05-ctrld-dns
#          sudo rm -f /etc/systemd/resolved.conf.d/50-magicdns-search.conf
#          omarchy dns DHCP
set -euo pipefail

MARKER='# Managed by chezmoi. Local config mode: ctrld does not regenerate this.'

RESOLVER_ID="{{ if hasKey . "controld_resolver_id" }}{{ .controld_resolver_id }}{{ end }}"
[[ -z "$RESOLVER_ID" ]] && exit 0

omarchy-pkg-aur-add ctrld-bin

# ControlD's curated captive-portal domains. A rule with no upstream resolves via
# the OS resolver, so the portal's DNS hijack still reaches us and its login page
# appears. Unauthenticated: the resolver ID identifies the endpoint.
excludes=$(curl -fsS --max-time 15 -X POST https://api.controld.com/utility \
    -H 'Content-Type: application/json' \
    -d "$(jq -nc --arg uid "$RESOLVER_ID" '{uid:$uid}')" 2>/dev/null |
    jq -r '.body.resolver.exclude[]?' | sort -u) || excludes=

# Fail closed: a config without these looks healthy and breaks at a hotel. Only
# ours carries the `ts.net` rule, so never migrate the unit onto a `--cd` file.
if [[ -z "$excludes" ]] && ! sudo grep -qF "$MARKER" /etc/controld/ctrld.toml 2>/dev/null; then
    echo "ControlD API unreachable and no chezmoi-managed ctrld.toml; leaving ctrld alone" >&2
    exit 1
fi

# `ts.net` first: rules match top to bottom. No ControlD fallback, so tailnet
# names never leave the machine; they just fail while the tailnet is down.
if [[ -n "$excludes" ]]; then
    rules="        {        'ts.net' = ['upstream.1']},
        {        '*.ts.net' = ['upstream.1']},"
    while read -r domain; do
        rules+=$'\n'"        {        '$domain' = []},"
    done <<<"$excludes"
    rules=${rules%,}

    ctrld_toml="$MARKER

# On by default: leaks to the network's resolver when an upstream fails, then
# unpins ctrld from every interface -- silently dropping filtering. The tailnet
# upstream is unreachable until tailscaled answers, so it fires on every boot.
[service]
  leak_on_upstream_failure = false

[listener]
  [listener.0]
    ip = '127.0.0.1'
    port = 53

    [listener.0.policy]
      name = 'My Policy'
      rules = [
$rules
      ]

[network]
  [network.0]
    name = 'Network 0'
    cidrs = ['0.0.0.0/0']

[upstream]
  [upstream.0]
    name = 'Control D'
    type = 'doh'
    endpoint = 'https://dns.controld.com/$RESOLVER_ID'
    bootstrap_ip = '76.76.2.22'
    timeout = 5000

  [upstream.1]
    name = 'Tailscale MagicDNS'
    type = 'legacy'
    endpoint = '100.100.100.100:53'
    timeout = 1000"

    if [[ "$(sudo cat /etc/controld/ctrld.toml 2>/dev/null)" != "$ctrld_toml" ]]; then
        # Stage and parse first: a half-written config survives into the next boot.
        sudo install -d -m 0755 /etc/controld
        staged=$(sudo mktemp /etc/controld/.ctrld.toml.XXXXXX)
        printf '%s\n' "$ctrld_toml" | sudo tee "$staged" >/dev/null
        if ! sudo python3 -c 'import sys,tomllib; tomllib.load(open(sys.argv[1],"rb"))' "$staged"; then
            sudo rm -f "$staged"
            echo "generated ctrld.toml did not parse; keeping the current one" >&2
            exit 1
        fi
        sudo chown root:root "$staged"
        sudo chmod 0600 "$staged"
        sudo mv "$staged" /etc/controld/ctrld.toml
        ctrld_changed=1
    fi
fi

# First run only. --skip_self_checks: ctrld's probe is flaky next to resolved.
[[ -f /etc/systemd/system/ctrld.service ]] ||
    sudo ctrld start --config=/etc/controld/ctrld.toml --skip_self_checks

# Unconditional so a first apply owns the unit too. Drops `--cd`, which would
# refetch and overwrite the config; a drop-in survives ctrld rewriting its unit.
unit_dropin=/etc/systemd/system/ctrld.service.d/10-local-config.conf
unit_dropin_content='[Unit]
# Narrows the boot window where the tailnet resolver is not answering yet.
After=tailscaled.service

[Service]
ExecStart=
ExecStart=/usr/bin/ctrld run --config=/etc/controld/ctrld.toml --homedir=/etc/controld --iface=auto --skip_self_checks'

if [[ "$(sudo cat "$unit_dropin" 2>/dev/null)" != "$unit_dropin_content" ]]; then
    sudo install -d -m 0755 /etc/systemd/system/ctrld.service.d
    printf '%s\n' "$unit_dropin_content" | sudo tee "$unit_dropin" >/dev/null
    sudo systemctl daemon-reload
    ctrld_changed=1
fi

if [[ -n "${ctrld_changed:-}" ]]; then
    sudo systemctl restart ctrld
fi

# Hand DNS to ctrld; keep tailscaled up for SSH. The `ts.net` rule keeps MagicDNS
# working: Quad100 answers whatever this is set to.
sudo tailscale set --accept-dns=false

# Short peer names need the suffix as a search domain. A resolved drop-in is the
# only durable spot: `dns=none` stops NetworkManager reaching resolved, and
# per-link state is wiped on restart. Derived at runtime, being a private id.
suffix=$(tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty') || suffix=
search_conf=/etc/systemd/resolved.conf.d/50-magicdns-search.conf
if [[ -n "$suffix" ]]; then
    search_conf_content="[Resolve]
Domains=$suffix"

    if [[ "$(sudo cat "$search_conf" 2>/dev/null)" != "$search_conf_content" ]]; then
        sudo install -d -m 0755 /etc/systemd/resolved.conf.d
        printf '%s\n' "$search_conf_content" | sudo tee "$search_conf" >/dev/null
        sudo systemctl restart systemd-resolved
        # resolved drops runtime per-link DNS on restart, and ctrld owns it.
        sudo systemctl restart ctrld
    fi
fi

# Pin every uplink to ctrld so DHCP never reintroduces the router's servers.
# ctrld only pins the link holding the default route when it starts, so any
# other link that comes up later carries DHCP DNS -- and systemd-resolved will
# happily use it, because resolution is routed per link.
#
# It has to be per connection profile: ctrld's own drop-in sets `dns=none`,
# which cuts NetworkManager's global-dns and [connection-*] defaults off from
# resolved. `omarchy dns Custom` writes the same profile settings, but it also
# rewrites resolved.conf with a FallbackDNS list -- the DHCP-DNS bypass this
# exists to prevent -- and skips gsm/cdma.
pin_dns() {
    sudo nmcli connection modify "$1" \
        ipv4.ignore-auto-dns yes ipv4.dns 127.0.0.1 \
        ipv6.ignore-auto-dns yes
}

pinned=
while IFS=: read -r uuid type; do
    case "$type" in
    802-11-wireless | 802-3-ethernet | gsm | cdma) ;;
    *) continue ;;
    esac
    [ "$(nmcli -g ipv4.ignore-auto-dns connection show "$uuid")" = "yes" ] || { pin_dns "$uuid"; pinned=1; }
done < <(nmcli -t -f UUID,TYPE connection show)

# Reapply only when something changed: it re-negotiates addressing and fires a
# dispatcher `up` event on every connected device.
if [ -n "$pinned" ]; then
    while IFS=: read -r dev state type; do
        [ "$state" = "connected" ] || continue
        case "$type" in wifi | ethernet | gsm) sudo nmcli device reapply "$dev" >/dev/null 2>&1 || true ;; esac
    done < <(nmcli -t -f DEVICE,STATE,TYPE device status)
fi

# Profiles added later (a new SSID) would still arrive unpinned, so catch them
# as they come up.
dispatcher=/etc/NetworkManager/dispatcher.d/05-ctrld-dns
dispatcher_content=$(cat <<'DISPATCHER'
#!/bin/bash
iface=$1
action=$2

[ "$action" = "up" ] || exit 0
[ -n "${CONNECTION_UUID:-}" ] || exit 0

case "$(nmcli -g connection.type connection show "$CONNECTION_UUID" 2>/dev/null)" in
    802-11-wireless|802-3-ethernet|gsm|cdma) ;;
    *) exit 0 ;;
esac

[ "$(nmcli -g ipv4.ignore-auto-dns connection show "$CONNECTION_UUID")" = "yes" ] && exit 0

nmcli connection modify "$CONNECTION_UUID" \
    ipv4.ignore-auto-dns yes ipv4.dns 127.0.0.1 ipv6.ignore-auto-dns yes
nmcli device reapply "$iface"
DISPATCHER
)

if [ "$(sudo cat "$dispatcher" 2>/dev/null)" != "$dispatcher_content" ]; then
    printf '%s\n' "$dispatcher_content" | sudo tee "$dispatcher" >/dev/null
    # NetworkManager silently skips dispatcher scripts that are not root-owned
    # or are group/other-writable.
    sudo chown root:root "$dispatcher"
    sudo chmod 0755 "$dispatcher"
fi

# `omarchy dns` and the shell's network panel read this file to pick the
# highlighted provider. Without it they show DHCP, inviting a click that would
# repoint DNS away from ctrld. Inert otherwise, given `dns=none`.
dns_conf=/etc/NetworkManager/conf.d/20-omarchy-dns.conf
dns_conf_content='# Managed by omarchy-dns. Remove this file or run omarchy dns DHCP to use DHCP DNS again.
[global-dns]

[global-dns-domain-*]
servers=127.0.0.1'

if [ "$(sudo cat "$dns_conf" 2>/dev/null)" != "$dns_conf_content" ]; then
    sudo install -d -m 0755 /etc/NetworkManager/conf.d
    printf '%s\n' "$dns_conf_content" | sudo tee "$dns_conf" >/dev/null
    sudo nmcli general reload conf >/dev/null 2>&1 || true
fi
