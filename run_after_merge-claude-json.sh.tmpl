#!/bin/bash
# Merge the MCP servers in .chezmoidata/mcp-servers.toml into ~/.claude.json,
# leaving Claude's own state (auth, project history, counters). Servers load
# their API keys via the agent-secrets wrapper.
#
# A running Claude rewrites ~/.claude.json on exit: apply with it closed, then
# restart it.
set -e

{{ template "merge-file.sh" }}

CLAUDE_JSON="$HOME/.claude.json"

servers={{ .mcp_servers | toJson | squote }}
# Ours are the ones run through with-agent-secrets: drop those no longer listed.
merge_file "$CLAUDE_JSON" '{}' jq --argjson servers "$servers" '
  .mcpServers = ((.mcpServers // {}) | with_entries(select(.value.command != "with-agent-secrets"
    or (.key as $k | $servers | has($k))))) |
  .mcpServers += ($servers | map_values({
    type: "stdio", command: "with-agent-secrets", args: ["npx", "-y", .package]
  }))'
