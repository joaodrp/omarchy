#!/bin/bash
# Merge the MCP servers in .chezmoidata/mcp-servers.toml into ~/.claude.json (Claude Code's user-scope
# config) without touching Claude's own state (auth, project history,
# counters). Servers load their API keys via the agent-secrets wrapper.
# Written only when it changes.
#
# NOTE: a running Claude rewrites ~/.claude.json on exit, so apply with Claude
# closed (and restart it) for the change to stick and load.
set -e

CLAUDE_JSON="$HOME/.claude.json"
[ -f "$CLAUDE_JSON" ] || echo '{}' > "$CLAUDE_JSON"

servers={{ .mcp_servers | toJson | squote }}
tmpfile=$(mktemp "$CLAUDE_JSON.XXXXXX")
trap 'rm -f "$tmpfile"' EXIT
jq --argjson servers "$servers" '
  .mcpServers += ($servers | map_values({
    type: "stdio", command: "with-agent-secrets", args: ["npx", "-y", .package]
  }))' "$CLAUDE_JSON" > "$tmpfile"
cmp -s "$tmpfile" "$CLAUDE_JSON" || mv "$tmpfile" "$CLAUDE_JSON"
