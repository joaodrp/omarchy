#!/bin/bash
# Tailscale settings that need an installed, authenticated node. Reconciled on
# every apply rather than from an installer: authenticating happens long after
# the install, and does not change any script's hash.
#
# `--ssh` lets tailnet peers SSH/Mosh in, ACL-gated, no keys.
#
# `--accept-dns` lets tailscaled own MagicDNS on its own link, leaving ControlD
# the default. Safe only while the tailnet's "Override DNS servers" is off; with
# it on, this machine silently moves to the shared tailnet profile.
set -e

{{ template "install-root-file.sh" }}

command -v tailscale >/dev/null || exit 0
tailscale status >/dev/null 2>&1 || exit 0

# Prefs are readable unprivileged, so sudo is asked only for a real change and
# a converged apply (the post-update hook included) needs none. The operator
# and Taildrop receiving repeat omarchy's post-login install steps, which an
# interrupted login skips for good: its installer never runs again.
if ! tailscale debug prefs 2>/dev/null |
    jq -e --arg me "$USER" '.RunSSH and .CorpDNS and .OperatorUser == $me' >/dev/null; then
    sudo tailscale set --ssh --accept-dns=true --operator="$USER"
fi
systemctl --user is-enabled --quiet omarchy-tailscale-receive.service ||
    systemctl --user enable --now omarchy-tailscale-receive.service

# Tailscale SSH services Unix-socket forwarding from the root tailscaled
# process, so an unprivileged session can reach root-only sockets. Unpatched as
# of 1.104.2; the daemon's kill switch drops the vector while leaving shells and
# Mosh intact. Set to 0 to retire, apply, then drop this block. Reconciles both
# ways and restarts only on a real change, so a routine apply never cuts the
# tunnel.
ssh_forwarding_disabled=1

key=TS_SSH_DISABLE_FORWARDING
dropin=/etc/systemd/system/tailscaled.service.d/10-ssh-forwarding.conf
restart=0
changed() { restart=1; }

if ((ssh_forwarding_disabled)); then
    install_root_file "$dropin" 644 $'[Service]\n'"Environment=$key=1" changed
elif [[ -e $dropin ]]; then
    sudo rm -f "$dropin" && changed
fi

# A drop-in, not the package's /etc/default/tailscaled, so tailscale upgrades
# never leave a .pacnew. Strips the key an earlier version wrote there.
env_file=/etc/default/tailscaled
if grep -q "^$key=" "$env_file" 2>/dev/null; then
    install_root_file "$env_file" 644 "$(sed "/^$key=/d" "$env_file")" changed
fi

if ((restart)); then
    sudo systemctl daemon-reload
    sudo systemctl restart tailscaled
fi
