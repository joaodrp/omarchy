#!/bin/bash
# Reboot into Windows once, through Limine's Windows entry: BitLocker without
# Secure Boot seals its key to the boot chain it was enabled on, which here
# includes Limine, so Windows must always start that way. Only the next boot
# changes; later ones fall back to Limine's default.
set -euo pipefail

usage="Usage: reboot-windows [-y|--yes]"
yes=false
for arg in "$@"; do
  case $arg in
    -y | --yes) yes=true ;;
    -h | --help) echo "$usage"; exit 0 ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
done

# Limine reports its entries to bootctl; the Windows entry's ID is its name.
entry=$(bootctl list --json=short 2>/dev/null |
  jq -r 'first(.[].id | select(startswith("Windows"))) // empty') || entry=""
if [[ -z $entry ]]; then
  echo "reboot-windows: Limine lists no Windows entry" >&2
  exit 1
fi

if ! $yes; then
  read -r -p "Reboot into Windows now? Open apps will close. [y/N] " answer || answer=""
  [[ $answer == [yY] ]] || { echo "Cancelled."; exit 1; }
fi

sudo bootctl set-oneshot "$entry"
exec omarchy-system reboot
