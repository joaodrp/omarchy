#!/bin/bash
# Enroll a YubiKey (FIDO) credential for pam_u2f unlock of polkit -- 1Password's
# "system authentication" and every other polkit action. Interactive (needs a
# fingerprint touch) and non-idempotent (mints a fresh credential each run), so
# it never runs unattended. Run once per machine; re-run with
# --add to append a backup key to this user's line. Other users' lines are kept.
#
# The RP ID is a fixed, hostname-independent string so one credential works on
# every omarchy machine, rather than pamu2fcfg's default `pam://$hostname`.
#
# The authfile is omarchy's own path, where `omarchy setup security fido2`
# points its pam_u2f lines. `-V` enrols a credential capable of on-device user
# verification, which is what userverification=1 later demands.
set -e

ORIGIN="{{ .yubikey.origin }}"
AUTHFILE="{{ .yubikey.authfile }}"
me="$(id -un)"

command -v pamu2fcfg >/dev/null \
    || { echo "omarchy-yubikey-enroll: pamu2fcfg not found (install pam-u2f)" >&2; exit 1; }

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Read the authfile once, failing closed: it is rewritten whole, so an
# unreadable one would lose other users' lines. Usernames compare literally.
existing=
if sudo test -e "$AUTHFILE"; then
    existing="$(sudo cat "$AUTHFILE")" \
        || { echo "omarchy-yubikey-enroll: cannot read $AUTHFILE; nothing written" >&2; exit 1; }
fi
mine() { awk -F: -v u="$me" '$1 == u' <<<"$existing"; }
others() { awk -F: -v u="$me" '$1 != u && NF' <<<"$existing"; }

case "${1:-}" in
    --add)
        line="$(mine | head -n1)"
        [ -n "$line" ] \
            || { echo "omarchy-yubikey-enroll: no line for $me in $AUTHFILE -- run without --add first" >&2; exit 1; }
        echo "omarchy-yubikey-enroll: touch the BACKUP key now..." >&2
        # -n prints only ":<credential>", ready to append.
        cred="$(pamu2fcfg -o "$ORIGIN" -i "$ORIGIN" -V -n)"
        printf '%s%s\n' "$line" "$cred" > "$tmp"
        ;;
    "")
        echo "omarchy-yubikey-enroll: touch the key now..." >&2
        # pamu2fcfg ends its line without a newline.
        printf '%s\n' "$(pamu2fcfg -o "$ORIGIN" -i "$ORIGIN" -V)" > "$tmp"
        ;;
    *)
        echo "usage: omarchy-yubikey-enroll [--add]" >&2; exit 2
        ;;
esac

# Guard against a truncated/garbled ceremony reaching /etc: the line must be
# this user's and carry at least one credential field.
head -n1 "$tmp" | awk -F: -v u="$me" '$1 == u && $2 != "" { ok = 1 } END { exit !ok }' \
    || { echo "omarchy-yubikey-enroll: unexpected pamu2fcfg output; nothing written" >&2; exit 1; }
others >> "$tmp"

# 644 root:root is the mode Omarchy's FIDO2 repair enforces: the file holds
# only public credential mappings, which pam_u2f may read as the user.
sudo install -D -m 644 -o root -g root "$tmp" "$AUTHFILE"
echo "omarchy-yubikey-enroll: wrote $AUTHFILE"
# omarchy's setup adds the pam_u2f lines; with the authfile in place it skips
# its own registration. Its closing sudo test asks for the password: the lines
# carry no origin until the hardener runs, so this key cannot answer it yet.
if ! grep -q pam_u2f.so /etc/pam.d/sudo; then
    echo "omarchy-yubikey-enroll: adding the pam_u2f lines; enter your password at its test" >&2
    omarchy setup security fido2
fi
# Invoked by the chezmoi enroller, the hardener runs in the same apply.
[ -n "${OMARCHY_ENROLL_FROM_APPLY:-}" ] ||
    echo "omarchy-yubikey-enroll: next, run chezmoi apply to harden the PAM lines" >&2
