#!/bin/bash

# omarchy:summary=Record dictation using Hex
# omarchy:args=<start|stop|toggle>

# Vendored from Omarchy (omacom/omarchy#17186) until a release ships it; the
# packaged copy in /usr/share/omarchy/bin comes first on PATH and takes over.
# Two changes: whether Hex runs is read from `hex status`, since hex-bin 3.0.0
# exits 1, not 3, when it is not running; and stop waits out the ~0.1 s before
# a fresh recording shows as dictating, so a quick tap does not leave it on.
no_speech=4

hex_state() {
  hex status 2>/dev/null | jq -r '.desktop.activity.state // empty'
}

start() {
  if ! hex status >/dev/null 2>&1; then
    hex start >/dev/null || return 1
  fi
  hex dictation start
}

# Hex pastes with a bare Ctrl+V, which terminals ignore, so take the transcript
# and let Omarchy type it into whatever is focused.
stop() {
  local text result try
  omarchy-cmd-missing hex && return 0
  for try in 1 2 3 4; do
    [[ $(hex_state) == "dictating" ]] && break
    (( try == 4 )) && return 0
    sleep 0.1
  done
  text=$(hex dictation stop --print)
  result=$?
  if (( result == 0 )); then
    omarchy-clipboard-paste-text "$text"
  elif (( result != no_speech )); then
    return "$result"
  fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  toggle)
    if [[ $(hex_state) == "dictating" ]]; then
      stop
    else
      start
    fi
    ;;
  *) echo "Usage: omarchy dictation hex <start|stop|toggle>" >&2; exit 1 ;;
esac
