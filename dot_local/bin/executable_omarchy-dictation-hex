#!/bin/bash

# omarchy:summary=Record dictation using Hex
# omarchy:args=<start|stop|toggle>

# Vendored from Omarchy (omacom/omarchy#17186) until a release ships it; the
# packaged copy in /usr/share/omarchy/bin comes first on PATH and takes over.
# Adapted to Hex 3.3: `hex status` is text unless asked for JSON, and reports
# a recording as the listener's status; `dictation start` is idempotent, and
# `stop --print` refuses when nothing records, so neither needs a state check.
not_running=3
no_speech=4

listener() {
  hex status --json 2>/dev/null | jq -r '.listener.status // empty'
}

start() {
  hex dictation start >/dev/null
  local result=$?
  if (( result == not_running )); then
    hex start >/dev/null && hex dictation start >/dev/null
  else
    return "$result"
  fi
}

# Hex pastes with a bare Ctrl+V, which terminals ignore, so take the transcript
# and let Omarchy type it into whatever is focused.
stop() {
  local text result
  omarchy-cmd-missing hex && return 0
  text=$(hex dictation stop --print 2>/dev/null)
  result=$?
  if (( result == 0 )); then
    omarchy-clipboard-paste-text "$text"
  elif (( result != no_speech )) && [[ $(listener) == "Recording" ]]; then
    return "$result"
  fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  toggle)
    if [[ $(listener) == "Recording" ]]; then
      stop
    else
      start
    fi
    ;;
  *) echo "Usage: omarchy dictation hex <start|stop|toggle>" >&2; exit 1 ;;
esac
