#!/bin/bash
# Report the machine state chezmoi cannot vendor: app toggles, logins and
# per-machine answers. Read-only. Exit status is the number of failed checks,
# so an agent walking BOOTSTRAP.md can loop until it is 0.

fails=0
ok() { printf '  \033[32mok\033[0m    %s\n' "$1"; }
bad() { printf '  \033[31mFAIL\033[0m  %s\n        -> %s\n' "$1" "$2"; fails=$((fails + 1)); }
opt() { printf '  \033[33mskip\033[0m  %s\n        -> %s\n' "$1" "$2"; }
check() { # check <label> <fix> <cmd...>
    local label=$1 fix=$2
    shift 2
    if "$@" >/dev/null 2>&1; then ok "$label"; else bad "$label" "$fix"; fi
}

echo "chezmoi"
src=$(chezmoi source-path 2>/dev/null)
check "source is $src" "chezmoi init --source ~/Developer/github.com/joaodrp/omarchy joaodrp/omarchy" \
    test "$src" = "$HOME/Developer/github.com/joaodrp/omarchy"
check "no pending file changes" "chezmoi apply" \
    bash -c '[ -z "$(chezmoi status --exclude=scripts 2>/dev/null)" ]'

echo "1Password (app: Settings > Developer)"
check "CLI integration" "turn on 'Integrate with 1Password CLI'" op account list
check "SSH agent serving keys" "turn on 'Use the SSH agent'" \
    env SSH_AUTH_SOCK="$HOME/.1password/agent.sock" ssh-add -l
check "agent secrets materialized" "refresh-agent-secrets (1Password unlocked)" \
    test -s "$HOME/.config/agent-secrets.env"

echo "Accounts"
check "gh authenticated" "gh auth login" gh auth status
check "cdctl logged in (Control D widget)" "chezmoi apply with 1Password unlocked" \
    cdctl auth status
if command -v tailscale >/dev/null; then
    check "tailscale logged in" "sudo tailscale up --accept-routes" tailscale status
else
    bad "tailscale installed" "chezmoi apply"
fi

echo "Desktop"
check "default agent set" "omarchy default agent claude" \
    bash -c '[ -n "$(omarchy-default-agent)" ]'
check "voxtype running" "chezmoi apply" systemctl --user is-active voxtype
if omarchy-hw-fingerprint 2>/dev/null; then
    check "fingerprint enrolled" "omarchy-setup-security-fingerprint" \
        test -f /etc/pam.d/omarchy-lock-fingerprint
fi
if [ -d /sys/bus/platform/drivers/hid_sensor_als ]; then
    check "light sensor rebinds after resume" "chezmoi apply" \
        systemctl is-enabled --quiet als-rebind.service
fi

echo "Per machine (optional)"
if [ -n "$(chezmoi execute-template '{{ .controld_resolver_id }}' 2>/dev/null)" ]; then
    ok "ControlD resolver set"
else
    opt "ControlD resolver not set" "add controld_resolver_id to ~/.config/chezmoi/chezmoi.toml, chezmoi apply"
fi
if omarchy-pkg-present apple-fonts 2>/dev/null; then
    ok "Apple fonts installed"
else
    opt "Apple fonts not installed (AUR checksums often stale)" "omarchy pkg aur add apple-fonts"
fi
if [ -s /etc/fido2/fido2 ]; then
    ok "YubiKey enrolled"
else
    opt "YubiKey not enrolled" "plug it in, omarchy-yubikey-enroll"
fi

echo
[ "$fails" -eq 0 ] && echo "All required checks pass." || echo "$fails required check(s) failing."
exit "$fails"
