#!/bin/bash
# Report the machine state chezmoi cannot vendor: app toggles, logins and
# per-machine answers. Read-only. Exit status is the number of failed checks,
# so an agent walking BOOTSTRAP.md can loop until it is 0.

fails=0
ok() { printf '  \033[32mok\033[0m    %s\n' "$1"; }
bad() { printf '  \033[31mFAIL\033[0m  %s\n        -> %s\n' "$1" "$2"; fails=$((fails + 1)); }
opt() { printf '  \033[33mskip\033[0m  %s\n        -> %s\n' "$1" "$2"; }
check() { # check <label> <fix> <cmd...>
    local label=$1 fix=$2
    shift 2
    if "$@" >/dev/null 2>&1; then ok "$label"; else bad "$label" "$fix"; fi
}

echo "chezmoi"
src=$(chezmoi source-path 2>/dev/null)
check "source is $src" "chezmoi init --source ~/Developer/github.com/joaodrp/omarchy joaodrp/omarchy" \
    test "$src" = "$HOME/Developer/github.com/joaodrp/omarchy"
check "no pending file changes" "chezmoi apply" \
    bash -c 'out=$(chezmoi status --exclude=scripts 2>/dev/null) && [ -z "$out" ]'

echo "1Password (app: Settings > Developer)"
check "CLI integration" "turn on 'Integrate with 1Password CLI'" op account list
check "SSH agent serving keys" "turn on 'Use the SSH agent'" \
    env SSH_AUTH_SOCK="$HOME/.1password/agent.sock" ssh-add -l
check "agent secrets materialized" "refresh-agent-secrets (1Password unlocked)" \
    test -s "$HOME/.config/agent-secrets.env"

echo "Accounts"
check "gh authenticated" "gh auth login" gh auth status
check "cdctl logged in (Control D widget)" "chezmoi apply with 1Password unlocked" \
    cdctl auth status
if command -v tailscale >/dev/null; then
    check "tailscale logged in" "sudo tailscale up --accept-routes" tailscale status
else
    bad "tailscale installed" "chezmoi apply"
fi

echo "Desktop"
check "default agent set" "omarchy default agent claude" \
    bash -c '[ -n "$(omarchy-default-agent)" ]'
check "superwhisper selected for dictation" "chezmoi apply" \
    bash -c '[ "$(omarchy-default-dictation 2>/dev/null)" = superwhisper ]'
check "superwhisper running" "omarchy-install-dictation-superwhisper" \
    systemctl --user is-active --quiet superwhisper
check "cleanup mode ready (shortcut and bar broom)" "gh auth login, then chezmoi apply" \
    hypr-cleanup-mode config --json
if omarchy-hw-fingerprint 2>/dev/null; then
    check "fingerprint enrolled" "omarchy-setup-security-fingerprint" \
        test -f /etc/pam.d/omarchy-lock-fingerprint
fi
if compgen -G '/sys/bus/acpi/devices/FRMW0005:*' >/dev/null; then
    check "light sensor rebinds after resume" "chezmoi apply" \
        systemctl is-enabled --quiet als-rebind.service
fi

if [ -e /sys/class/leds/chromeos:white:power ] && omarchy-hw-fingerprint 2>/dev/null; then
    check "power button blinks for fingerprint" "chezmoi apply" \
        systemctl is-active --quiet fingerprint-led.service
fi

# The 1Password scale flag rides on its generated autostart unit; flag it when
# 1Password renames that unit and the drop-in stops applying.
if [ -e "$HOME/.config/autostart/com.onepassword.OnePassword.desktop" ]; then
    if systemctl --user show -p ExecStart app-com.onepassword.OnePassword@autostart.service 2>/dev/null |
        grep -q -- --force-device-scale-factor=1; then
        ok "1Password autostarts at the right scale"
    else
        opt "1Password autostart lost its scale flag" \
            "match the drop-in in ~/.config/systemd/user/ to 1Password's autostart unit"
    fi
fi

check "web system fonts resolve to Inter / JetBrains Mono" "chezmoi apply" \
    bash -c '[ "$(fc-match -f "%{family[0]}" "system\-ui")" = Inter ] &&
        [ "$(fc-match -f "%{family[0]}" "\-apple\-system")" = Inter ] &&
        [ "$(fc-match -f "%{family[0]}" "ui\-monospace")" = "JetBrainsMono Nerd Font" ]'

echo "Per machine (optional)"
if [ -n "$(chezmoi execute-template '{{ .controld_resolver_id }}' 2>/dev/null)" ]; then
    ok "ControlD resolver set"
else
    opt "ControlD resolver not set" "add controld_resolver_id to ~/.config/chezmoi/chezmoi.toml, chezmoi apply"
fi
if [ -s /etc/fido2/fido2 ]; then
    ok "YubiKey enrolled"
else
    opt "YubiKey not enrolled" "plug it in, omarchy-yubikey-enroll"
fi
# A clone of omarchy's polkit plugin with pam_u2f support (omacom/omarchy#6515)
# shadows the packaged one, so drop it once the package has the fix.
if [ -d "$HOME/.config/omarchy/plugins/joaodrp.polkit" ]; then
    if grep -q pam_u2f /usr/share/omarchy/shell/plugins/polkit/PolkitModel.js 2>/dev/null; then
        opt "polkit plugin clone no longer needed" \
            "omarchy plugin enable omarchy.polkit && omarchy plugin remove joaodrp.polkit --yes && omarchy restart shell"
    else
        ok "polkit plugin clone (pam_u2f) still needed"
    fi
fi

echo "Pinned plugins (optional)"
# Third-party shell plugins are pinned to a commit; flag the ones whose
# upstream default branch has moved on, so they get reviewed and bumped.
awk '/^\["\.config\/omarchy\/plugins\// { p = 1; next }
     /^\[/ { p = 0 }
     p && match($0, /github\.com\/[^\/]+\/[^\/]+\/archive\/[0-9a-f]{40}\.tar\.gz/) {
         split(substr($0, RSTART, RLENGTH), u, "/"); print u[2] "/" u[3], substr(u[5], 1, 40)
     }' "$src/.chezmoiexternal.toml.tmpl" 2>/dev/null |
    while read -r repo sha; do
        if ! cmp=$(timeout 20 gh api "repos/$repo/compare/$sha...HEAD" \
            --jq '"\(.status) \(.ahead_by)"' 2>/dev/null); then
            opt "$repo: could not check upstream" "gh auth status; check the network"
            continue
        fi
        read -r status ahead <<<"$cmp"
        case $status in
        identical) ok "$repo pinned at its latest commit" ;;
        ahead) opt "$repo: $ahead upstream commit(s) since the pin" \
            "review https://github.com/$repo/compare/${sha:0:12}...HEAD for security and compatibility, then bump the pin" ;;
        *) opt "$repo: upstream history no longer contains the pin ($status)" \
            "check https://github.com/$repo for a rewritten branch before bumping" ;;
        esac
    done

echo "Tracked upstream issues (optional)"
# Workarounds carry a "REVERT once <owner>/<repo>#<n>" marker. Report each
# issue's state; for Omarchy's own, also whether the merged fix is in the
# installed release, which is when the workaround can go.
omarchy_tag="v$(pacman -Q omarchy 2>/dev/null | awk '{ sub(/-[0-9]+$/, "", $2); print $2 }')"
git -C "$src" grep -hoE 'REVERT once [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+' 2>/dev/null |
    awk '{ print $3 }' | sort -u |
    while read -r ref; do
        repo=${ref%#*} num=${ref#*#}
        files=$(git -C "$src" grep -l "REVERT once $ref" | paste -sd ' ')
        if ! info=$(timeout 20 gh issue view "$num" -R "$repo" \
            --json state,closedByPullRequestsReferences \
            --jq '"\(.state) \([.closedByPullRequestsReferences[].number] | join(","))"' 2>/dev/null); then
            opt "$ref: could not check" "gh auth status; check the network"
            continue
        fi
        read -r state prs <<<"$info"
        if [ "$state" = OPEN ]; then
            ok "$ref still open${prs:+ (fix in review: #$prs)}; keep the workaround"
            continue
        fi
        released=""
        if [ "$repo" = omacom/omarchy ] && [ "$omarchy_tag" != v ]; then
            for pr in ${prs//,/ }; do
                sha=$(timeout 20 gh pr view "$pr" -R "$repo" --json mergeCommit --jq '.mergeCommit.oid // empty' 2>/dev/null) || continue
                [ -n "$sha" ] || continue
                case $(timeout 20 gh api "repos/$repo/compare/$sha...$omarchy_tag" --jq .status 2>/dev/null) in
                identical | ahead) released=yes ;;
                *) released=no ;;
                esac
            done
        fi
        case $released in
        yes) opt "$ref is fixed in your Omarchy ($omarchy_tag)" "revert the workaround in: $files" ;;
        no) ok "$ref is fixed upstream but not yet in your Omarchy ($omarchy_tag); keep the workaround" ;;
        *) opt "$ref is closed" "check that the fix reached you, then revert the workaround in: $files" ;;
        esac
    done

echo
[ "$fails" -eq 0 ] && echo "All required checks pass." || echo "$fails required check(s) failing."
exit "$fails"
