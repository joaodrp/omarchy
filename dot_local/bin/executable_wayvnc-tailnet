#!/bin/bash
# Serve the Hyprland desktop over VNC, bound to the Tailscale IP only (ufw
# already keeps 5900 off the LAN). Waits for Tailscale to come up first; the
# timeout is generous because giving up costs a restart cycle rather than
# failing fast into one.
#
# `--gpu` captures through DMA-BUF instead of a CPU copy of every frame, which
# is most of what makes a scaled 1440p output tolerable over the tailnet.
set -e

timeout=300
elapsed=0
while ! ip=$(tailscale ip -4 2>/dev/null) || [ -z "$ip" ]; do
    sleep 2
    elapsed=$((elapsed + 2))
    if [ "$elapsed" -ge "$timeout" ]; then
        logger -t wayvnc-tailnet "gave up after ${timeout}s waiting for tailscale ip -4; wayvnc not started"
        exit 1
    fi
done

exec wayvnc --gpu "$ip" 5900
