#!/bin/bash
# Own which resolver this machine uses.
#
#   dns-controld            restore ControlD and verify it is answering
#   dns-controld --pause    stand down until the next restore
#   dns-controld --status   exit 0 when ControlD is the only resolver in play
#
# ControlD is configured globally in resolved rather than per link. That is
# deliberate: a link-scoped resolver fails open, so a new SSID would resolve
# through DHCP with no filtering and no signal. Global scope fails closed.
#
# The price is that global scope also forces DNSOverTLS, which a plain resolver
# -- a hotel portal, a router, a Pi-hole -- cannot answer under; resolved falls
# back to ControlD rather than failing, so picking one looks applied but is
# not. Pausing is how you stand ControlD down on purpose.
#
# The DNS panel cannot bring it back: the resolver id rides in the DoT SNI
# hostname, which its Custom dialog only takes addresses for.
set -euo pipefail

DROPIN=/etc/systemd/resolved.conf.d/50-controld.conf
PAUSED=$DROPIN.disabled
RESOLVED_CONF=/etc/systemd/resolved.conf
# Only DNS= accumulates across the main file and drop-ins; drop-ins already
# outrank the main file for FallbackDNS and DNSOverTLS.
PANEL_KEY='^[[:space:]]*DNS[[:space:]]*='
NM_CONF=/etc/NetworkManager/conf.d/99-dns-none.conf
# Resolution is routed per link, so a DHCP server on one would outrank the
# global endpoint. `dns=none` alone is not enough: NM still pushes over D-Bus.
NM_CONF_CONTENT='[main]
dns=none
systemd-resolved=false'
# Only a provider label for `omarchy dns`, which reads NM global-dns and then
# resolved.conf but never resolved.conf.d, so it cannot see the real endpoint.
# Inert under dns=none. Without it the panel reports DHCP and invites a click.
MARKER=/etc/NetworkManager/conf.d/20-omarchy-dns.conf
MARKER_CONTENT='# Managed by chezmoi. A provider label for omarchy, not the endpoint in use:
# that is /etc/systemd/resolved.conf.d/50-controld.conf.
[global-dns]

[global-dns-domain-*]
servers=76.76.2.22,76.76.10.22'

# Uplinks carrying their own DNS. Any one of them outranks the global endpoint
# for its own traffic, so a single entry here is a bypass. tailscale0 is
# excluded: MagicDNS is tailscaled's to manage and is scoped to ts.net.
links_with_dns() {
    while IFS=: read -r dev state type; do
        [[ $state == connected ]] || continue
        case "$type" in wifi | ethernet | gsm) ;; *) continue ;; esac
        [[ -n "$(resolvectl dns "$dev" 2>/dev/null | sed 's/^[^:]*://;s/[[:space:]]//g')" ]] || continue
        printf '%s\n' "$dev"
    done < <(nmcli -t -f DEVICE,STATE,TYPE device status)
}

# ControlD answering is not enough -- a resolver on any uplink could answer
# first and never show up here. Both halves, or it is not healthy.
controld_is_live() {
    resolvectl status 2>/dev/null | grep -q 'Current DNS Server.*dns\.controld\.com' &&
        [[ -z "$(links_with_dns)" ]]
}

# Needs no privileges, and the menu calls it on every open.
if [[ ${1:-} == --status ]]; then
    controld_is_live
    exit $?
fi

# Same escalation omarchy-dns uses, so this works from a terminal and from the
# menu, where there is no tty to take a password.
if ((EUID != 0)); then
    [[ -t 0 ]] && escalate=sudo || escalate=pkexec
    exec "$escalate" "$(readlink -f "${BASH_SOURCE[0]}")" "$@"
fi

# Root has no session bus; the notification has to go back to the caller.
notify_caller() {
    local uid=${PKEXEC_UID:-${SUDO_UID:-}}
    [[ -n $uid ]] || return 0
    runuser -u "$(id -nu "$uid" 2>/dev/null)" -- \
        env "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" \
        notify-send -u critical "$@" 2>/dev/null || true
}

# Returns 1 for "already correct". A failed write is fatal, not a no-op: it
# would otherwise be indistinguishable, leaving DHCP suppression off.
write_conf() {
    [[ "$(cat "$1" 2>/dev/null)" == "$2" ]] && return 1
    printf '%s\n' "$2" | install -Dm644 /dev/stdin "$1" || {
        echo "dns-controld: cannot write $1" >&2
        exit 1
    }
}

reload_network() {
    systemctl reload NetworkManager 2>/dev/null || true
    systemctl restart systemd-resolved
    # NetworkManager only publishes DNS for a profile once it is reapplied.
    while IFS=: read -r dev state; do
        [[ $state == connected ]] || continue
        nmcli device reapply "$dev" >/dev/null 2>&1 || true
    done < <(nmcli -t -f DEVICE,STATE device status)
}

if [[ ${1:-} == --pause ]]; then
    [[ -f $DROPIN ]] && mv "$DROPIN" "$PAUSED"
    # Hand DNS back to DHCP, and stop claiming to be on ControlD.
    rm -f "$NM_CONF" "$MARKER"
    reload_network
    echo "DNS: ControlD paused; whatever the panel or DHCP provides is now in use."
    echo "Restore with: dns-controld"
    exit 0
fi

changed=
# The guards go down before the drop-in comes back: interrupted here, DNS is
# simply still paused, rather than ControlD active with DHCP free to publish.
write_conf "$NM_CONF" "$NM_CONF_CONTENT" && changed=1
write_conf "$MARKER" "$MARKER_CONTENT" && changed=1
[[ -f $PAUSED ]] && { mv "$PAUSED" "$DROPIN"; changed=1; }
grep -qE "$PANEL_KEY" "$RESOLVED_CONF" 2>/dev/null &&
    { sed -i -E "/$PANEL_KEY/d" "$RESOLVED_CONF"; changed=1; }

[[ -n $changed ]] && reload_network
# Pausing lets DHCP put servers on the uplinks; they have to go on the way back.
for dev in $(links_with_dns); do
    resolvectl revert "$dev" 2>/dev/null || true
done

# Wait on the resolver actually answering rather than a fixed guess.
for _ in $(seq 20); do
    controld_is_live && break
    sleep 0.25
done

# A real IP means something else answered. `|| true` so a total DNS failure
# still reaches the diagnostics below instead of exiting on the pipeline.
blocked=$(getent ahostsv4 ads.doubleclick.net 2>/dev/null | awk 'NR==1 {print $1}') || true
stray=$(links_with_dns)
if [[ $blocked == "0.0.0.0" && -z $stray ]]; then
    echo "DNS: ControlD (filtering active)"
    exit 0
fi

echo "DNS: ControlD configured, but the check failed." >&2
echo "  test lookup returned '${blocked:-nothing}' (want 0.0.0.0)" >&2
[[ -n $stray ]] && echo "  uplinks still carrying their own DNS: ${stray//$'\n'/ }" >&2
notify_caller "DNS" "ControlD is not answering; check resolvectl status"
exit 1
