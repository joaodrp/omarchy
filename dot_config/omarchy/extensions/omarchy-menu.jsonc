{
  // Extends the Quickshell menu. Field reference and defaults:
  // /usr/share/omarchy/default/omarchy/omarchy-menu.jsonc
  //
  // ControlD needs its own row because the panel can switch away from it but
  // not back: the resolver id rides in the DoT SNI hostname, which the Custom
  // dialog cannot express.
  //
  // `omarchy-dns` reports ControlD as Custom, so neither row can key off that
  // alone without both ticking. Match the live resolver instead, and redeclare
  // Custom so it excludes ControlD.
  //
  // ControlD sorts last and cannot be moved: rows keep the position of their
  // first declaration, and the defaults load first. Redeclaring an id updates
  // its fields without moving it, and `when` does not hide a stock row.
  "setup.network.dns.controld": {"icon":"󰇧","label":"ControlD","checked":"resolvectl status 2>/dev/null | grep -q 'Current DNS Server.*dns\\.controld\\.com'","action":"dns-controld"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(omarchy-dns)\" == \"Custom\" ]] && ! resolvectl status 2>/dev/null | grep -q 'dns\\.controld\\.com'","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-dns Custom'"},
}
