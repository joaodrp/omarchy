[Unit]
Description=wayvnc on the Tailscale address
# wayvnc captures a Wayland output, so it is meaningless without a session:
# the condition keeps it from restarting into nothing, matching omarchy's own
# Wayland-bound units. Supervision is the point -- losing the output (a dock or
# monitor replug) kills wayvnc, and Hyprland's autostart hook fires only at
# login, so a blip left VNC down until the next one.
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=graphical-session.target
After=graphical-session.target
# Never give up: a monitor can come back long after it went. The backoff keeps
# a wayvnc that fails fast from respinning.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/bin/wayvnc-tailnet
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=2min

[Install]
WantedBy=graphical-session.target
