#!/bin/bash
# Local models: Ollama built for this machine's GPU (CUDA on NVIDIA, Vulkan on
# any other GPU, CPU only otherwise), running at boot on 127.0.0.1, and llmfit
# to find the models that fit. Ollama skips integrated GPUs unless told
# otherwise, so the Vulkan build gets that switch when the machine has a single
# GPU; beside a dedicated card it would split models onto the slower one.
# Idempotent: packages are added only when missing, and the unit override
# changes only on a real difference.
set -e

{{ template "install-root-file.sh" }}

OVERRIDE=/etc/systemd/system/ollama.service.d/chezmoi-igpu.conf
reload() { sudo systemctl daemon-reload && sudo systemctl try-restart ollama.service; }
# An Intel or AMD display controller: a software Vulkan driver alone would put
# Ollama on an emulated device.
hw_gpu() {
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [[ -r $dev/class && $(<"$dev/class") == 0x03* ]] || continue
        case $(<"$dev/vendor") in 0x8086 | 0x1002) return 0 ;; esac
    done
    return 1
}

if omarchy-hw-nvidia; then
    pkg=ollama-cuda
elif hw_gpu && omarchy-hw-vulkan; then
    pkg=ollama-vulkan
else
    pkg=ollama
fi
omarchy pkg add "$pkg" llmfit

if [ "$pkg" = ollama-vulkan ] && ! omarchy-hw-hybrid-gpu; then
    install_root_file "$OVERRIDE" 644 "# Managed by chezmoi (joaodrp/omarchy).
[Service]
Environment=OLLAMA_IGPU_ENABLE=1" reload
elif [ -e "$OVERRIDE" ]; then
    sudo rm -f "$OVERRIDE"
    reload
fi

sudo systemctl enable --now ollama.service
