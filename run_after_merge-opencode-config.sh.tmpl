#!/bin/bash
# Add the MCP servers in .chezmoidata/mcp-servers.toml to
# ~/.config/opencode/opencode.json. Servers load their API keys via the
# agent-secrets wrapper.
#
# Preserves omarchy defaults and opencode's runtime writes; written only when
# it changes.
set -e

config="$HOME/.config/opencode/opencode.json"
mkdir -p "$(dirname "$config")"
[ -f "$config" ] || echo '{}' > "$config"

servers={{ .mcp_servers | toJson | squote }}
tmpfile=$(mktemp "$config.XXXXXX")
trap 'rm -f "$tmpfile"' EXIT
jq --argjson servers "$servers" '
  .mcp += ($servers | map_values({
    type: "local", command: ["with-agent-secrets", "npx", "-y", .package], enabled: true
  }))' "$config" > "$tmpfile"
cmp -s "$tmpfile" "$config" || mv "$tmpfile" "$config"
