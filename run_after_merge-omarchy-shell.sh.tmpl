#!/bin/bash
# Wire the vendored widgets into omarchy's shell config. omarchy owns this file
# and rewrites it at runtime (disabled plugins, clone-source restores, bar
# rearrangements), so only these entries are managed: each is merged over in
# whichever section it already sits, so per-widget state and a bar section the
# user moved it to both survive, and inserted only when absent everywhere: in
# place of the widget it "replaces", else at the end of its "section", else
# after the tray. Both hints are not written. A managed "hidden" list (the
# tray's) is added to the user's own rather than replacing it.
#
# $layout then fixes the order of the widgets it lists, on every apply: each
# goes to its listed section and slot, keeping its own settings. A listed
# widget this machine lacks is skipped; an unlisted one stays where it is,
# after the listed ones in its section.
#
# Control D's commands are the vendored `dns-controld`; that widget does
# nothing without them, so cloning the plugin alone only does half the job.
set -e

{{ template "merge-file.sh" }}

config="$HOME/.config/omarchy/shell.json"
[ -f "$config" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# Electron and Chromium tray icons only answer a right-click; Brave and LM
# Studio share the generic Chromium id.
entries='[
  {
    "id": "omarchy.tray",
    "hidden": ["chrome_status_icon_1", "Claude_status_icon_1", "1Password_status_icon_1"]
  },
  {
    "id": "io.github.joaodrp.controld",
    "statusCommand": "dns-controld --status",
    "pauseCommand": "dns-controld --pause",
    "resumeCommand": "dns-controld"
  },
  {
    "id": "io.github.joaodrp.auto-brightness"
  },
  {
    "id": "io.github.joaodrp.green-room"
  },
  {
    "id": "harshith.system-monitor"
  },
  {
    "id": "robzolkos.github"
  },
  {
    "id": "hass"
  },
  {
    "id": "reysu.things"
  },
  {
    "id": "crmne.omacal",
    "replaces": "omarchy.clock",
    "section": "center",
    "googleEnabled": true,
    "heyEnabled": false
  },
  {
    "id": "io.github.alvmarrod.stocks",
    "section": "tray"
  }
]'

# The Control D widget looks for cdctl once, when it loads. On a first apply
# cdctl is built after this runs, so hold the widget back until the next one.
if ! command -v cdctl >/dev/null 2>&1; then
    entries=$(jq -c 'map(select(.id != "io.github.joaodrp.controld"))' <<<"$entries")
fi

layout='{
  "left": ["omarchy.menu", "omarchy.workspaces"],
  "centerBegin": ["omarchy.indicators"],
  "center": ["crmne.omacal", "reysu.things", "omarchy.elsewhen", "omarchy.weather"],
  "centerEnd": ["omarchy.system-update"],
  "right": [
    "omarchy.tray",
    "robzolkos.github", "hass", "omarchy.agents",
    "superwhisper.panel", "omarchy.keyboard-layout",
    "io.github.joaodrp.green-room", "io.github.joaodrp.portrait-camera",
    "omarchy.dropbox", "omarchy.tailscale", "io.github.joaodrp.controld",
    "omarchy.bluetooth", "omarchy.network", "omarchy.audio",
    "io.github.joaodrp.auto-brightness", "omarchy.monitor", "omarchy.power"
  ],
  "tray": ["io.github.joaodrp.cleanup-mode", "harshith.system-monitor", "io.github.alvmarrod.stocks"]
}'

# Swap Nautilus's dock pin for Strata. The dock reads Omarchy's default pins
# only while dock.pinned is absent, so seed it from them once; after that the
# user's own order is kept.
defaults="${OMARCHY_PATH:-/usr/share/omarchy}/config/omarchy/shell.json"

merge_file "$config" '{}' jq --argjson entries "$entries" --argjson layout "$layout" \
    --slurpfile defaults "$defaults" '
  def wid: if type == "object" then .id else . end;
  def placed($id): any(.bar.layout[][]; wid == $id);
  # A config without a layout shows the default bar from Omarchy, and a section
  # that is not a list shows as empty; make both explicit before editing.
  (if (.bar.layout | type) == "object" then . else .bar.layout = $defaults[0].bar.layout end)
  | .bar.layout |= map_values(if type == "array" then . else [] end)
  | reduce $entries[] as $e (.;
      ($e.id) as $id
      | ($e | del(.section, .replaces)) as $entry
      | if placed($id)
        then (.bar.layout[][] | select(wid == $id)) |= (
               (if type == "object" then . else {id: .} end) as $old
               | $old * $entry
               | if $entry.hidden then .hidden = ((($old.hidden // []) + $entry.hidden) | unique) else . end)
        elif $e.replaces and placed($e.replaces)
        then (.bar.layout[][] | select(wid == $e.replaces)) |= $entry
        elif $e.section then .bar.layout[$e.section] += [$entry]
        else .bar.layout.right = (
               .bar.layout.right as $r
               | ($r | map(wid) | index("omarchy.tray")) as $i
               | if $i == null then $r + [$entry]
                 else $r[0:$i+1] + [$entry] + $r[$i+1:]
                 end)
        end
    )
  | ([$layout[][]]) as $listed
  | .bar.layout as $cur
  | [$cur[][]] as $all
  | .bar.layout = (
      ($cur | map_values(map(select(wid as $w | $listed | index($w) | not))))
      | reduce ($layout | keys_unsorted[]) as $k (.;
          .[$k] = ([$layout[$k][] as $id | $all[] | select(wid == $id)] + (.[$k] // []))))
  | .dock.pinned = ((.dock.pinned // $defaults[0].dock.pinned // [])
    | map(if . == "org.gnome.Nautilus" then "io.github.lgse.Strata" else . end))
'
