#!/bin/bash
# Blink the Framework power-button LED while fprintd waits for a finger: the
# reader sits in the button, and nothing else shows when it wants a touch.
# Ported to bash and modified from
# https://github.com/alejandroqh/framework-fingerprint-led-blink, under the
# Apache License 2.0 (LICENSES/Apache-2.0.txt in this repo).
#
# Installed only where a fingerprint reader and the EC power LED exist;
# elsewhere it is removed. Idempotent: writes, reloads and enables only on a
# real change.
set -e

{{ template "install-root-file.sh" }}

SCRIPT=/usr/local/lib/fingerprint-led
UNIT=/etc/systemd/system/fingerprint-led.service
LED=/sys/class/leds/chromeos:white:power

read -r -d '' SCRIPT_CONTENT <<'SCRIPT' || true
#!/bin/bash
# Managed by chezmoi (joaodrp/omarchy). Ported to bash and modified from
# https://github.com/alejandroqh/framework-fingerprint-led-blink, under the
# Apache License 2.0 (https://www.apache.org/licenses/LICENSE-2.0).
# Blinks the power-button LED from VerifyStart/EnrollStart until a stop call or
# a final status (done = true), for at most 60s, then hands the LED back to the
# EC. While every display is off it hands the LED back too, and blinks again on
# wake: the lock lets an attempt run on after blanking, and a wake may resume
# that same attempt.
led=${LED:-/sys/class/leds/chromeos:white:power}
worker=

# Dark only when every connected display reports DPMS Off; an unreadable state
# counts as lit, so a prompt never loses its cue.
dark() {
    local c lit=1
    for c in /sys/class/drm/card*-*; do
        [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
        [ "$(cat "$c/dpms" 2>/dev/null)" = Off ] || return 1
        lit=0
    done
    return $lit
}
blink() {
    local i state='' want
    for ((i = 0; i < 60; i++)); do
        if dark; then want=dark; else want=lit; fi
        if [ "$want" != "$state" ]; then
            if [ "$want" = lit ]; then
                echo timer > "$led/trigger"
                echo 250 > "$led/delay_on"
                echo 250 > "$led/delay_off"
            else
                echo chromeos-auto > "$led/trigger"
            fi
            state=$want
        fi
        sleep 1
    done
    echo chromeos-auto > "$led/trigger"
}
# Waits for the worker, so a stopped one never writes over what follows.
off() {
    if [ -n "$worker" ]; then
        kill "$worker" 2>/dev/null
        wait "$worker" 2>/dev/null
    fi
    worker=
    echo chromeos-auto > "$led/trigger"
}
on() {
    [ -n "$worker" ] && kill -0 "$worker" 2>/dev/null && return
    blink &
    worker=$!
}
off
status=0
while read -r line; do
    case $line in
        "method call "*member=VerifyStart | "method call "*member=EnrollStart) on ;;
        "method call "*member=VerifyStop | "method call "*member=EnrollStop | \
        "method call "*member=Release) off ;;
        *member=VerifyStatus | *member=EnrollStatus) status=1 ;;
        "boolean true") [ "$status" = 1 ] && off; status=0 ;;
        "boolean false") status=0 ;;
    esac
done < <(dbus-monitor --system "interface='net.reactivated.Fprint.Device'")
off
SCRIPT

read -r -d '' UNIT_CONTENT <<UNIT || true
# Managed by chezmoi (joaodrp/omarchy).
[Unit]
Description=Blink the power-button LED while fprintd waits for a finger
After=dbus.service

[Service]
ExecStartPre=/usr/bin/modprobe ledtrig-timer
ExecStart=$SCRIPT
ExecStopPost=/bin/sh -c 'echo chromeos-auto > $LED/trigger'
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
UNIT

if [ ! -e "$LED" ] || ! omarchy-hw-fingerprint; then
    if [ -e "$UNIT" ]; then
        sudo systemctl disable --now fingerprint-led.service >/dev/null 2>&1 || true
        sudo rm -f "$UNIT" "$SCRIPT"
        sudo systemctl daemon-reload
    fi
    exit 0
fi

reload_unit() {
    sudo systemctl daemon-reload
    sudo systemctl try-restart fingerprint-led.service
}
install_root_file "$UNIT" 644 "$UNIT_CONTENT" reload_unit
install_root_file "$SCRIPT" 755 "$SCRIPT_CONTENT" sudo systemctl try-restart fingerprint-led.service
systemctl is-enabled --quiet fingerprint-led.service 2>/dev/null ||
    sudo systemctl enable --now --quiet fingerprint-led.service
