{{/* Vendor my own bar widgets -- except one being developed on this machine,
     whose plugin path is a symlink to its working checkout. An external would
     replace that symlink with a clone, silently ending the dev loop: edits
     would stop reaching the shell with nothing to indicate why. A checkout
     merely present under ~/Developer does not count. */ -}}

{{ range $id, $repo := dict
    "controld" "omarchy-controld-panel"
    "auto-brightness" "omarchy-auto-brightness"
    "green-room" "omarchy-green-room" -}}
{{   $path := printf ".config/omarchy/plugins/io.github.joaodrp.%s" $id -}}
{{   $st := lstat (joinPath $.chezmoi.homeDir $path) -}}
{{   if not (and $st (eq $st.type "symlink")) -}}
[{{ $path | quote }}]
    type = "git-repo"
    url = "https://github.com/joaodrp/{{ $repo }}.git"
    refreshPeriod = "168h"
    [{{ $path | quote }}.pull]
        args = ["--ff-only"]

{{   end -}}
{{ end -}}

{{/* Agent skills; the list and why each is pinned are in
     .chezmoidata/agent-skills.toml. */ -}}

{{ range $name, $s := .agent_skills -}}
[{{ printf ".agents/skills/%s" $name | quote }}]
    type = "archive"
    url = "https://github.com/{{ $s.repo }}/archive/{{ $s.commit }}.tar.gz"
    exact = true
    stripComponents = {{ add 1 (len (splitList "/" $s.path)) }}
    include = [{{ printf "*/%s/**" $s.path | quote }}]

{{ end -}}

{{/* Strata's Taildrop provider, from its own repo at its latest release, so a
     new release lands on the next apply; provider.json beside it is the
     template in dot_config/strata/private_providers/taildrop/. */ -}}
[".config/strata/providers/taildrop/provider.py"]
    type = "file"
    url = "https://raw.githubusercontent.com/joaodrp/strata-taildrop/{{ (gitHubLatestRelease "joaodrp/strata-taildrop").TagName }}/provider.py"

{{/* Strata's Dropbox provider and its badges, from its own repo at its latest
     release; Strata loads icons only from beside provider.json, the template in
     dot_config/strata/private_providers/dropbox/. */ -}}
{{ $dropbox := (gitHubLatestRelease "joaodrp/strata-dropbox").TagName -}}
{{ range list "provider.py" "icons/synced.png" "icons/syncing.png" "icons/error.png" "icons/excluded.png" "icons/LICENSE-lucide" -}}
[".config/strata/providers/dropbox/{{ base . }}"]
    type = "file"
    url = "https://raw.githubusercontent.com/joaodrp/strata-dropbox/{{ $dropbox }}/{{ . }}"
{{ end -}}
